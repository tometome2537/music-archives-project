{
  "name": "music-archives-project",
  "version": "3.3.20",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "update": "npm update --save && npm run create_license && npm outdated",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint --write",
    "format": "biome format --write",
    "check": "biome check --write",
    "api_tome_create": "openapi-generator generate -i ./src/openapi-client/api-node-tometome-openapi.yaml -g typescript-fetch -o ./src/openapi-client/api-node-tometome",
    "create_license": "npx license-checker --json | jq 'with_entries(.value |= del(.path, .licenseFile, .noticeFile))' > app/license/licenses.json"
  },
  "engines": {
    "node": "^26.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@koozaki/romaji-conv": "^2.0.35",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@mui/x-date-pickers": "^9.17.0",
    "@next/third-parties": "^16.4.3",
    "@sentry/nextjs": "^11.10.0",
    "dayjs": "^1.11.23",
    "js-cookie": "^3.0.8",
    "linkify-plugin-hashtag": "^4.4.0",
    "linkify-plugin-mention": "^4.4.0",
    "linkify-react": "^4.4.0",
    "linkifyjs": "^4.3.3",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-youtube": "^10.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "license-checker": "^25.0.1",
    "typescript": "^7.0.2"
  }
}
